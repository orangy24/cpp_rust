#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "$0")" && pwd)"
cd "$root"

name="${1:-}"
if [[ -z "$name" ]]; then
  echo "Usage: ./run <topic>     # signatures raii-loans views qos templates"
  echo "                         # static-poly policies policies-serialize"
  echo "                         # type-erasure pubsub nodes abi memory"
  echo "                         # concurrency-queue concurrency-executor"
  echo "       ./run practice          # your Catch2 file practice/tests.cpp"
  echo "       ./run practice-sandbox  # practice/sandbox.cpp"
  echo "       ./run rust"
  exit 1
fi

if [[ "$name" == "rust" ]]; then
  exec cargo test --manifest-path rust/Cargo.toml -- --nocapture
fi

if [[ ! -d "build" ]]; then
  cmake --preset debug || cmake -S . -B build -DCMAKE_BUILD_TYPE=Debug
fi
cmake --build build --target "$name"
exec "./build/$name"
